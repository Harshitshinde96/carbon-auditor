# =============================================================================
# Carbon Auditor — Backend Environment Variables
# =============================================================================
# Copy to .env and fill in real values. Never commit .env to version control.
# See docs/PRD.md §21 for full documentation.
# =============================================================================

# ── Global ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
AWS_REGION=us-east-1

# ── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-strong-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI Services ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_URL=https://your-cluster.cloud.qdrant.io

# ── Data Storage ────────────────────────────────────────────────────────────
S3_UPLOAD_BUCKET=carbon-auditor-uploads
DYNAMO_TABLE_USERS=carbon-users
DYNAMO_TABLE_BILLS=carbon-bills
DYNAMO_TABLE_EMISSIONS=carbon-emissions
DYNAMO_TABLE_SETTINGS=carbon-settings
DYNAMO_TABLE_REPORTS=carbon-reports

# ── AWS Credentials (prefer IAM instance role on EC2) ───────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
